# Host-level runtime directories
PUID=1000
PGID=1000
DWE_MUSIC_DIR=/srv/dwe/music
DWE_NAVIDROME_DATA_DIR=/srv/dwe/navidrome/data
DWE_STAGING_DIR=/srv/dwe/staging
DWE_SYNC_LOG_DIR=/srv/dwe/sync/logs
NAVIDROME_PORT=4533

# MinIO source-of-truth settings
MINIO_ENDPOINT=minio.example.local:9000
MINIO_BUCKET=dwe-audio
MINIO_AUDIO_PREFIX=audio
MINIO_ACCESS_KEY=replace-with-readonly-user-access-key
MINIO_SECRET_KEY=replace-with-readonly-user-secret-key
MINIO_SECURE=false

# rclone settings
RCLONE_REMOTE=minio
RCLONE_REMOTE_PREFIX=dwe-audio/audio
RCLONE_DEST=/srv/dwe/music
RCLONE_LOG_DIR=/srv/dwe/sync/logs

# Sync safety defaults
SYNC_MODE=dry-run
SYNC_INTERVAL=0

# LLM（Ollama）設定（Issue #12）。Ollama は家庭内ネットワーク上のローカル
# サービスであり認証情報を持たないため、API キーは設定しない。
# コンテナ内からホストの Ollama へ到達するため、既定は host.docker.internal
# を使う（docker-compose の extra_hosts で host-gateway へ解決される）。
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PREDICT=2048

# プレイリスト生成の上限（LLM へ渡すカタログ件数とプレイリスト長）
PLAYLIST_CATALOG_LIMIT=200
PLAYLIST_DEFAULT_SIZE=10
PLAYLIST_MAX_SIZE=50
