# Host-level runtime directories
PUID=1000
PGID=1000
DWE_MUSIC_DIR=/srv/dwe/music
DWE_NAVIDROME_DATA_DIR=/srv/dwe/navidrome/data
DWE_STAGING_DIR=/srv/dwe/staging
DWE_SYNC_LOG_DIR=/srv/dwe/sync/logs
NAVIDROME_PORT=4533

# MinIO source-of-truth settings
MINIO_ENDPOINT=minio.example.local:9000
MINIO_BUCKET=dwe-audio
MINIO_AUDIO_PREFIX=audio
MINIO_ACCESS_KEY=replace-with-readonly-user-access-key
MINIO_SECRET_KEY=replace-with-readonly-user-secret-key
MINIO_SECURE=false

# rclone settings
RCLONE_REMOTE=minio
RCLONE_REMOTE_PREFIX=dwe-audio/audio
RCLONE_DEST=/srv/dwe/music
RCLONE_LOG_DIR=/srv/dwe/sync/logs

# Sync safety defaults
SYNC_MODE=dry-run
SYNC_INTERVAL=0
